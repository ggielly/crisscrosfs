{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo wdk build",
            "type": "shell",
            "command": "cargo",
            "args": ["wdk", "build", "--target-arch", "amd64"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "cargo wdk build (verbose)",
            "type": "shell",
            "command": "cargo",
            "args": ["wdk", "build", "--target-arch", "amd64", "-v"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$rustc"
        }
    ]
}